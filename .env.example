# ── Groq (required for JARVIS intelligence, speech-to-text and voice) ──
GROQ_API_KEY=
# Primary chat model, then comma-separated fallbacks (used on capacity/rate errors)
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Backup cloud voice (JARVIS speaks with Piper, below). Orpheus needs a one-time terms acceptance:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=daniel

# ── JARVIS's voice (Piper, offline) ──
# The starting voice; change or add voices in SYSTEM → JARVIS VOICE (PC) or Settings (phone).
ARC_VOICE=en_US-bryce-medium

# ── ARC server ──
ARC_PORT=7777
# Folders JARVIS may open / search / create / delete files in (semicolon separated).
# Defaults to your Desktop, Documents and Downloads.
ARC_FILE_ROOTS=
# true  → LOW risk desktop actions (open an app, open a website) run immediately.
# false → every desktop action asks for confirmation (the "Open VS Code? YES / NO" flow).
ARC_AUTO_EXECUTE_LOW_RISK=false
